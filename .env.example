# ============================================================
# NEXORA EMA CROSS — CONFIGURATION
# ============================================================

# Binance USD-M Futures
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_WS_BASE_URL=wss://fstream.binance.com/ws
TIMEFRAME=1h
EMA_FAST=50
EMA_SLOW=200
CANDLE_LIMIT=250

# Symbols to track (comma-separated, or ALL for all active USDT perps)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,NEARUSDT,SUIUSDT,APTUSDT,ARBUSDT,OPUSDT,1000PEPEUSDT
ALL_SYMBOLS=false

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Web Dashboard & API
HOST=0.0.0.0
PORT=8080

# Paths & Cache
DB_PATH=data/nexora.db
CHARTS_DIR=charts
CHART_WIDTH=1600
CHART_HEIGHT=900
CHART_DPI=100
CACHE_TTL_SECONDS=300
